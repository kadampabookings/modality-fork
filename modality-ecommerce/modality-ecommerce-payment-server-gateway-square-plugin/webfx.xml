<?xml version="1.0" encoding="UTF-8"?>
<project>

    <description>The SPI payment gateway implementation for making embedded payments with Square.</description>

    <exported-packages>
        <source-packages/>
        <resource-packages/>
    </exported-packages>

    <dependencies>
        <used-by-source-modules/>
        <!-- okhttp-jvm must be listed explicitly: okhttp:5.x is a Kotlin Multiplatform library whose pom
             relies on Gradle metadata for JVM variant selection (not supported by Maven). Without this,
             Maven only resolves the metadata-only artifact (empty jar, no class files). -->
        <plugin-module>okhttp-jvm</plugin-module>
    </dependencies>

    <providers>
        <provider interface="one.modality.ecommerce.payment.server.gateway.PaymentGateway">one.modality.ecommerce.payment.server.gateway.impl.square.SquarePaymentGateway</provider>
        <provider interface="dev.webfx.platform.boot.spi.ApplicationJob">one.modality.ecommerce.payment.server.gateway.impl.square.SquareRestApiJob</provider>
    </providers>

    <required-libraries>
        <!-- Square library -->
        <library name="square">
            <groupId>com.squareup</groupId>
            <artifactId>square</artifactId>
            <version>46.0.0.20260122</version>
            <!-- These dependencies clash with some underlying Vert.x modules, so we solve this issue by excluding them -->
            <exclusions>
                <exclusion>
                    <groupId>com.sun.activation</groupId>
                    <artifactId>javax.activation</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>jakarta.activation</groupId>
                    <artifactId>jakarta.activation-api</artifactId>
                </exclusion>
            </exclusions>
            <exported-packages>
                <package>com.squareup.square</package>
                <package>com.squareup.square.core</package>
                <package>com.squareup.square.types</package>
                <package>com.squareup.square.checkout.types</package>
            </exported-packages>
        </library>
        <!-- okhttp-jvm must be declared explicitly: okhttp:5.x is a Kotlin Multiplatform library whose pom
             relies on Gradle metadata for JVM variant selection (not supported by Maven). Without this,
             Maven only resolves the metadata-only artifact (empty jar, no class files). -->
        <library name="okhttp-jvm">
            <groupId>com.squareup.okhttp3</groupId>
            <artifactId>okhttp-jvm</artifactId>
            <version>5.2.1</version>
        </library>
    </required-libraries>

</project>