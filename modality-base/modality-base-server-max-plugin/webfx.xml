<?xml version="1.0" encoding="UTF-8"?>
<project>

    <description>Convenient module that embeds all server modules of the Base layer.</description>

    <exported-packages>
        <source-packages/>
    </exported-packages>

    <dependencies>
        <used-by-source-modules/>

        <!-- Allowing configuration variables from file (conf folder) & system properties (ex: user.dir) in executables (Vert.x) -->
        <plugin-module>webfx-platform-conf-file-jre-plugin</plugin-module>
        <plugin-module>webfx-platform-substitution-var-conf-plugin</plugin-module>
        <plugin-module>webfx-platform-substitution-var-sysprop-plugin</plugin-module>

        <!-- Min -->
        <plugin-module>modality-base-server-min-plugin</plugin-module>

        <!-- Facebook and Google SSO are DELIBERATELY ABSENT. Neither gateway verifies anything: Google's
             authenticateImpl is `promise.complete(PREFIX + token)` with a "No double verification for
             now" comment, and both read their claims from a JWT decoded without checking its signature
             (Jwt has a getDecodedSignature() that nothing calls). Facebook's debug_token audience-check
             URL is defined and never called.

             Registering a gateway is what makes the server ACCEPT a principal, and acceptsUserId() is a
             string-prefix test — so this had nothing to do with whether a login button was offered. Any
             client could send userId="Google.<a JWT it wrote itself>", pass the prefix test, pass
             verifyAuthenticated (which only decodes), and have the authorization provider look up grants
             by the email claim inside that unsigned token.

             KBS does not offer SSO login, so these are removed rather than restricted — the same choice
             made for the unauthenticated /proxy/* route. Restore them WITH signature and audience
             verification if and when SSO is actually offered; putting the plugin back is what re-opens
             the acceptance path, so that is the moment to check. See
             docs/design/identity-binding-spec.md.

             MojoAuth stays: it verifies (Jwks.verifyAccessToken). -->

        <!-- + MojoAuth SSO -->
        <plugin-module>webfx-stack-authn-login-server-gateway-mojoauth-plugin</plugin-module>
        <plugin-module>webfx-stack-authn-server-gateway-mojoauth-plugin</plugin-module>

    </dependencies>

</project>