<?xml version="1.0" encoding="UTF-8"?>
<project>

    <description>Secured REST endpoints for cloud images (upload/delete/exists), replacing the
        unauthenticated generic ones from webfx-stack-cloud-image-rest-server-plugin.</description>

    <exported-packages>
        <source-packages/>
        <resource-packages/>
    </exported-packages>

    <dependencies>
        <used-by-source-modules>
            <undetected-module>webfx-platform-async</undetected-module>
        </used-by-source-modules>
    </dependencies>

    <providers>
        <provider interface="dev.webfx.platform.boot.spi.ApplicationModuleBooter">one.modality.base.server.rest.images.SecuredImagesRestService</provider>
    </providers>

</project>
