<?xml version="1.0" encoding="UTF-8"?>
<!-- File managed manually for now; mirrors modality-base-server-rest-map-vertx-plugin structure. -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>one.modality</groupId>
        <artifactId>modality-event</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>modality-event-server-rest-bunny-stream-vertx-plugin</artifactId>

    <description>
        Server-side Vert.x REST proxy for Bunny.net Stream video uploads.
        Exposes /rest/videos/{init,status,abort,library,…} so the backoffice
        can drive a direct browser → bunny.net TUS upload while keeping the
        per-organization Bunny API key strictly server-side, and performs the
        idempotent Media insert + ScheduledItem.published flip on transcoding
        completion. Credentials are resolved per-request from the database by
        walking ScheduledItem → Event → Organization.
    </description>

    <dependencies>

        <!-- Domain entities (Event, Organization, ScheduledItem, Media) -->
        <dependency>
            <groupId>one.modality</groupId>
            <artifactId>modality-base-shared-entities</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>

        <!-- Vert.x for HTTP route registration -->
        <dependency>
            <groupId>io.vertx</groupId>
            <artifactId>vertx-core</artifactId>
        </dependency>
        <dependency>
            <groupId>io.vertx</groupId>
            <artifactId>vertx-web</artifactId>
        </dependency>

        <dependency>
            <groupId>dev.webfx</groupId>
            <artifactId>webfx-platform-async</artifactId>
            <version>0.1.0-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>dev.webfx</groupId>
            <artifactId>webfx-platform-ast</artifactId>
            <version>0.1.0-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>dev.webfx</groupId>
