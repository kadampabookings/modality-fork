<?xml version="1.0" encoding="UTF-8"?>
<project>

    <description>Convenient module that embeds the minimal set of server plugin modules required for the CRM layer.</description>

    <exported-packages>
        <source-packages/>
    </exported-packages>

    <dependencies>
        <used-by-source-modules/>

        <plugin-module>modality-crm-server-authn-gateway-usernamepassword-plugin</plugin-module>
        <plugin-module>modality-crm-server-authn-gateway-guest-plugin</plugin-module>
        <plugin-module>modality-crm-server-authn-gateway-magiclink-plugin</plugin-module>
        <plugin-module>modality-crm-server-authn-gateway-webauthn-plugin</plugin-module>
        <plugin-module>modality-crm-server-authz-required-plugin</plugin-module>
        <!-- Without this module the identity token still slides and is still capped, but nothing rotates
             it and a stolen copy stays undetectable — a plugin module is only built in if a list names
             it, so leaving this out is a silent reduction in what a compromise looks like. -->
        <plugin-module>modality-crm-server-authsession-plugin</plugin-module>

    </dependencies>

</project>