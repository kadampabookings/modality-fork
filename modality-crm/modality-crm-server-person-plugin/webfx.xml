<?xml version="1.0" encoding="UTF-8"?>
<project>

    <!-- Merging a duplicate person into the one being kept, as an endpoint rather than as the loop of raw
         updates the customers screen used to send (front-office write-authorization plan, step 1 — the
         last of its six statements). It keeps the modality/service/person address that PersonService will
         carry in step 2. -->

    <exported-packages>
        <source-packages/>
    </exported-packages>

    <dependencies>
        <used-by-source-modules/>
        <source-module>modality-crm-server-authn-gateway-shared</source-module>
        <source-module>modality-crm-shared-authn</source-module>
        <source-module>webfx-stack-com-bus-call</source-module>
        <source-module>webfx-stack-db-query</source-module>
        <source-module>webfx-stack-db-submit</source-module>
        <source-module>webfx-stack-orm-datasourcemodel</source-module>
        <source-module>webfx-stack-session-state</source-module>
    </dependencies>

    <!-- ApproveInvitationEndpoint and CreateInvitationEndpoint are written and deliberately NOT
         registered. They are two halves of one thing and only close the hole together: approving trusts
         invitation.inviter, and while a client can still INSERT an invitation it can name anybody there.
         Creating server-side does not help on its own either — it would hand a caller a server-minted
         token for a row they authored, which the email-link page still approves with no session at all.
         Both register in the change that denies clients the invitation table and moves that page onto
         the endpoint; PersonLinkCheck fails while either is switched on before then. Nothing runs that
         check automatically — see scripts/checks/person-service/run.sh. -->

    <providers>
        <provider interface="dev.webfx.stack.com.bus.call.spi.BusCallEndpoint">one.modality.crm.server.person.MergeDuplicatePersonsEndpoint</provider>
        <provider interface="dev.webfx.stack.com.bus.call.spi.BusCallEndpoint">one.modality.crm.server.person.RevokeLinkEndpoint</provider>
    </providers>

</project>
